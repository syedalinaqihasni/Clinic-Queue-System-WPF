<Window
    x:Class="ClinicQueueSystem.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clinic Administration"
    Width="1220"
    Height="780"
    MinWidth="980"
    MinHeight="650"
    Background="#F3F6FB"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Margin="0,0,0,14"
            Padding="18"
            Background="#17365D"
            CornerRadius="12">
            <DockPanel>
                <StackPanel>
                    <TextBlock
                        FontSize="23"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="ADMINISTRATION CENTER" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="#D7E5F5"
                        Text="Manage clinic configuration, users and local JSON data" />
                </StackPanel>
                <Button
                    VerticalAlignment="Center"
                    Click="Close_Click"
                    Content="Close"
                    DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
        <TabControl
            x:Name="AdminTabs"
            Grid.Row="1"
            Background="White">
            <TabItem Header="Departments">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Click="AddDepartment_Click" Content="Add" />
                        <Button Click="DeleteDepartment_Click" Content="Delete selected" />
                        <Button Click="SaveMaster_Click" Content="Save changes" />
                    </StackPanel>
                    <DataGrid
                        x:Name="DepartmentsGrid"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="False" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Doctors">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Click="AddDoctor_Click" Content="Add" />
                        <Button Click="DeleteDoctor_Click" Content="Delete selected" />
                        <Button Click="SaveMaster_Click" Content="Save changes" />
                    </StackPanel>
                    <DataGrid
                        x:Name="DoctorsGrid"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="False" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Shifts">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Click="AddShift_Click" Content="Add" />
                        <Button Click="DeleteShift_Click" Content="Delete selected" />
                        <Button Click="SaveMaster_Click" Content="Save changes" />
                    </StackPanel>
                    <DataGrid
                        x:Name="ShiftsGrid"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="False" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Counters">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Click="AddCounter_Click" Content="Add" />
                        <Button Click="DeleteCounter_Click" Content="Delete selected" />
                        <Button Click="SaveMaster_Click" Content="Save changes" />
                    </StackPanel>
                    <DataGrid
                        x:Name="CountersGrid"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="False" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Printers">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Click="AddPrinter_Click" Content="Add" />
                        <Button Click="DeletePrinter_Click" Content="Delete selected" />
                        <Button Click="SaveMaster_Click" Content="Save changes" />
                    </StackPanel>
                    <DataGrid
                        x:Name="PrintersGrid"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="False" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Users &amp; Roles">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Click="AddUser_Click" Content="Add user" />
                        <Button Click="SetPassword_Click" Content="Set password" />
                        <Button Click="DeleteUser_Click" Content="Delete selected" />
                        <Button Click="SaveMaster_Click" Content="Save changes" />
                    </StackPanel>
                    <TextBlock
                        Margin="4,8"
                        DockPanel.Dock="Bottom"
                        Foreground="#52647A"
                        Text="Allowed roles: ADMIN and RECEPTIONIST. At least one active ADMIN account must remain." />
                    <DataGrid
                        x:Name="UsersGrid"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="False" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Clinic Settings">
                <StackPanel MaxWidth="720" Margin="28">
                    <TextBlock
                        Margin="4,4,4,16"
                        FontSize="23"
                        FontWeight="Bold"
                        Text="Clinic identity and ticket settings" />
                    <TextBlock Text="Clinic name" />
                    <TextBox x:Name="ClinicNameBox" Margin="4,6,4,16" />
                    <TextBlock Text="Ticket footer" />
                    <TextBox x:Name="TicketFooterBox" Margin="4,6,4,16" />
                    <Button
                        HorizontalAlignment="Left"
                        Background="#17365D"
                        Click="SaveSettings_Click"
                        Content="Save settings"
                        Foreground="White" />
                    <TextBlock
                        Margin="4,12"
                        Foreground="#52647A"
                        Text="Changes apply to newly printed tickets." />
                </StackPanel>
            </TabItem>
            <TabItem Header="Tickets &amp; Audit">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DataGrid
                        x:Name="TicketsGrid"
                        Grid.Row="0"
                        AutoGenerateColumns="True"
                        IsReadOnly="True" />
                    <DataGrid
                        x:Name="AuditGrid"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        AutoGenerateColumns="True"
                        IsReadOnly="True" />
                </Grid>
            </TabItem>
            <TabItem Header="JSON Editor">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="4,4,4,10"
                        Text="Directly edit the complete clinic-data.json document. Invalid JSON or removal of the last active admin will be rejected. Make a backup first."
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="JsonEditor"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        FontFamily="Consolas"
                        FontSize="13"
                        HorizontalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" />
                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button Click="ReloadJson_Click" Content="Reload from file" />
                        <Button Click="ValidateJson_Click" Content="Validate JSON" />
                        <Button
                            Background="#198754"
                            Click="SaveJson_Click"
                            Content="Save JSON changes"
                            Foreground="White" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Backup">
                <StackPanel MaxWidth="700" Margin="20">
                    <TextBlock
                        Margin="4,4,4,12"
                        FontSize="22"
                        FontWeight="Bold"
                        Text="Data storage and backup" />
                    <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12">
                        <Button Click="Backup_Click" Content="Create backup" />
                        <Button Click="Restore_Click" Content="Restore backup" />
                        <Button Click="OpenFolder_Click" Content="Open data folder" />
                    </WrapPanel>
                    <TextBlock
                        Margin="4,12"
                        Foreground="#52647A"
                        Text="JSON is a local file format. Keep a backup before editing the JSON directly. This app is intended for a single reception PC; simultaneous writes from multiple PCs are not safe with a shared JSON file."
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="4,10,4,0"
            Foreground="#52647A"
            Text="Admin changes are saved locally." />
    </Grid>
</Window>
