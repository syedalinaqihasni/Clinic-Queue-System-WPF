<Window x:Class="ClinicQueueSystem.AdminWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clinic Administration" Height="780" Width="1220" MinHeight="650" MinWidth="980" WindowStartupLocation="CenterOwner" Background="#F3F6FB">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#17365D" CornerRadius="12" Padding="18" Margin="0,0,0,14"><DockPanel><StackPanel><TextBlock Text="ADMINISTRATION CENTER" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="Manage clinic configuration, users and local JSON data" Foreground="#D7E5F5" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" VerticalAlignment="Center"/></DockPanel></Border>
  <TabControl x:Name="AdminTabs" Grid.Row="1" Background="White">
   <TabItem Header="Departments"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Add" Click="AddDepartment_Click"/><Button Content="Delete selected" Click="DeleteDepartment_Click"/><Button Content="Save changes" Click="SaveMaster_Click"/></StackPanel><DataGrid x:Name="DepartmentsGrid" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="False"/></DockPanel></TabItem>
   <TabItem Header="Doctors"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Add" Click="AddDoctor_Click"/><Button Content="Delete selected" Click="DeleteDoctor_Click"/><Button Content="Save changes" Click="SaveMaster_Click"/></StackPanel><DataGrid x:Name="DoctorsGrid" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="False"/></DockPanel></TabItem>
   <TabItem Header="Shifts"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Add" Click="AddShift_Click"/><Button Content="Delete selected" Click="DeleteShift_Click"/><Button Content="Save changes" Click="SaveMaster_Click"/></StackPanel><DataGrid x:Name="ShiftsGrid" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="False"/></DockPanel></TabItem>
   <TabItem Header="Counters"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Add" Click="AddCounter_Click"/><Button Content="Delete selected" Click="DeleteCounter_Click"/><Button Content="Save changes" Click="SaveMaster_Click"/></StackPanel><DataGrid x:Name="CountersGrid" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="False"/></DockPanel></TabItem>
   <TabItem Header="Printers"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Add" Click="AddPrinter_Click"/><Button Content="Delete selected" Click="DeletePrinter_Click"/><Button Content="Save changes" Click="SaveMaster_Click"/></StackPanel><DataGrid x:Name="PrintersGrid" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="False"/></DockPanel></TabItem>
   <TabItem Header="Users &amp; Roles"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Add user" Click="AddUser_Click"/><Button Content="Set password" Click="SetPassword_Click"/><Button Content="Delete selected" Click="DeleteUser_Click"/><Button Content="Save changes" Click="SaveMaster_Click"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="Allowed roles: ADMIN and RECEPTIONIST. At least one active ADMIN account must remain." Margin="4,8" Foreground="#52647A"/><DataGrid x:Name="UsersGrid" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="False"/></DockPanel></TabItem>
   <TabItem Header="Clinic Settings"><StackPanel Margin="28" MaxWidth="720"><TextBlock Text="Clinic identity and ticket settings" FontSize="23" FontWeight="Bold" Margin="4,4,4,16"/><TextBlock Text="Clinic name"/><TextBox x:Name="ClinicNameBox" Margin="4,6,4,16"/><TextBlock Text="Ticket footer"/><TextBox x:Name="TicketFooterBox" Margin="4,6,4,16"/><Button Content="Save settings" HorizontalAlignment="Left" Background="#17365D" Foreground="White" Click="SaveSettings_Click"/><TextBlock Text="Changes apply to newly printed tickets." Foreground="#52647A" Margin="4,12"/></StackPanel></TabItem>
   <TabItem Header="Tickets &amp; Audit"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid x:Name="TicketsGrid" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True"/><DataGrid x:Name="AuditGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,10,0,0"/></Grid></TabItem>
   <TabItem Header="JSON Editor"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Directly edit the complete clinic-data.json document. Invalid JSON or removal of the last active admin will be rejected. Make a backup first." TextWrapping="Wrap" Margin="4,4,4,10"/><TextBox x:Name="JsonEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Reload from file" Click="ReloadJson_Click"/><Button Content="Validate JSON" Click="ValidateJson_Click"/><Button Content="Save JSON changes" Background="#198754" Foreground="White" Click="SaveJson_Click"/></StackPanel></Grid></TabItem>
   <TabItem Header="Backup"><StackPanel Margin="20" MaxWidth="700"><TextBlock Text="Data storage and backup" FontSize="22" FontWeight="Bold" Margin="4,4,4,12"/><TextBlock x:Name="StoragePathText" TextWrapping="Wrap"/><WrapPanel Margin="0,12"><Button Content="Create backup" Click="Backup_Click"/><Button Content="Restore backup" Click="Restore_Click"/><Button Content="Open data folder" Click="OpenFolder_Click"/></WrapPanel><TextBlock Text="JSON is a local file format. Keep a backup before editing the JSON directly. This app is intended for a single reception PC; simultaneous writes from multiple PCs are not safe with a shared JSON file." TextWrapping="Wrap" Foreground="#52647A" Margin="4,12"/></StackPanel></TabItem>
  </TabControl>
  <TextBlock x:Name="StatusText" Grid.Row="2" Text="Admin changes are saved locally." Foreground="#52647A" Margin="4,10,4,0"/>
 </Grid>
</Window>
