<Window
    x:Class="ClinicQueueSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clinic Queue System v1.2.1"
    Width="1180"
    Height="760"
    MinWidth="950"
    MinHeight="650"
    Background="#F3F5F8"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Padding="20"
            Background="#17365D">
            <DockPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="CLINIC QUEUE SYSTEM" />
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="UserLabel"
                        Margin="12"
                        VerticalAlignment="Center"
                        Foreground="White" />
                    <Button
                        x:Name="AdminButton"
                        Click="Admin_Click"
                        Content="Admin / Data" />
                    <Button Click="Logout_Click" Content="Logout" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1" Margin="14">
            <TabItem Header="Reception">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="8">
                        <TextBlock
                            Margin="4,0,4,16"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="Issue Queue Ticket" />
                        <TextBlock Text="Department" />
                        <ComboBox
                            x:Name="DepartmentCombo"
                            DisplayMemberPath="Name"
                            SelectionChanged="Department_Changed" />
                        <TextBlock Text="Doctor (optional)" />
                        <ComboBox x:Name="DoctorCombo" DisplayMemberPath="Name" />
                        <TextBlock Text="Shift" />
                        <ComboBox x:Name="ShiftCombo" DisplayMemberPath="Name" />
                        <TextBlock Text="Counter" />
                        <ComboBox x:Name="CounterCombo" DisplayMemberPath="Name" />
                        <TextBlock Text="Fee (Rs.)" />
                        <TextBox x:Name="PriceBox" Text="500" />
                        <Grid Margin="4,20,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
        Grid.Column="0"
        Height="58"
        Margin="0,0,4,0"
        Background="#17365D"
        Click="Save_Click"
        Content="SAVE TICKET"
        FontSize="18"
        FontWeight="Bold"
        Foreground="White" />

                            <Button
        Grid.Column="1"
        Height="58"
        Margin="4,0,0,0"
        Background="#198754"
        Click="Print_Click"
        Content="PRINT TICKET"
        FontSize="18"
        FontWeight="Bold"
        Foreground="White" />
                        </Grid>
                        <TextBlock
                            x:Name="StatusLabel"
                            Margin="4,10"
                            Text="Ready"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Margin="18,8,8,8"
                        Padding="25"
                        Background="White"
                        CornerRadius="10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                Foreground="#68778D"
                                Text="NEXT TICKET PREVIEW" />
                            <TextBlock
                                x:Name="NextTicketLabel"
                                Margin="0,18"
                                HorizontalAlignment="Center"
                                FontSize="58"
                                FontWeight="Bold"
                                Foreground="#17365D"
                                Text="G001" />
                            <TextBlock
                                x:Name="PreviewDepartment"
                                HorizontalAlignment="Center"
                                FontSize="23"
                                FontWeight="SemiBold"
                                Text="General OPD" />
                            <TextBlock
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                Foreground="#68778D"
                                Text="Numbering resets by department, shift and date"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Separator Margin="0,15" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="Recent tickets" />
                            <DataGrid
                                x:Name="RecentGrid"
                                Height="240"
                                AutoGenerateColumns="True"
                                CanUserAddRows="False"
                                IsReadOnly="True" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Ticket History">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Click="Refresh_Click" Content="Refresh" />
                        <Button Click="Reprint_Click" Content="Reprint Selected" />
                        <Button Click="Void_Click" Content="Void Selected" />
                        <Button Click="Export_Click" Content="Export CSV" />
                    </StackPanel>
                    <DataGrid
                        x:Name="HistoryGrid"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        SelectionMode="Single" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Admin">
                <ScrollViewer>
                    <StackPanel
                        MaxWidth="900"
                        Margin="20"
                        HorizontalAlignment="Left">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Text="Clinic settings and master data" />
                        <TextBlock
                            Margin="0,8,0,16"
                            Text="Use the JSON data editor below for common master records. Keep backups of clinic-data.json."
                            TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Click="ManageDepartments_Click" Content="Manage Departments" />
                            <Button Click="ManageDoctors_Click" Content="Manage Doctors" />
                            <Button Click="ManageShifts_Click" Content="Manage Shifts" />
                            <Button Click="ManageCounters_Click" Content="Manage Counters" />
                            <Button Click="ManagePrinters_Click" Content="Manage Printers" />
                            <Button Click="ManageUsers_Click" Content="Manage Users" />
                        </WrapPanel>
                        <TextBlock Text="Clinic name" />
                        <TextBox x:Name="ClinicNameBox" />
                        <TextBlock Text="Ticket footer" />
                        <TextBox x:Name="FooterBox" />
                        <Button
                            HorizontalAlignment="Left"
                            Click="SaveSettings_Click"
                            Content="Save clinic settings" />
                        <TextBlock
                            Margin="4,18,4,4"
                            FontWeight="Bold"
                            Text="Storage file" />
                        <TextBlock x:Name="StoragePathLabel" TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Click="OpenDataFolder_Click"
                            Content="Open data folder" />
                        <Button
                            HorizontalAlignment="Left"
                            Click="Backup_Click"
                            Content="Backup JSON data now" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border
            Grid.Row="2"
            Padding="8"
            Background="#E0E6EE">
            <TextBlock
                x:Name="FooterStatus"
                Foreground="#455468"
                Text="Local JSON storage | .NET Framework 4.8" />
        </Border>
    </Grid>
</Window>
