<Window
    x:Class="ClinicQueueSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clinic Queue System v1.2.1"
    Width="1180"
    Height="760"
    MinWidth="950"
    MinHeight="650"
    Background="#F3F5F8"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Padding="20"
            Background="#17365D">
            <DockPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="CLINIC QUEUE SYSTEM" />
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="UserLabel"
                        Margin="12"
                        VerticalAlignment="Center"
                        Foreground="White" />
                    <Button
                        x:Name="AdminButton"
                        Click="Admin_Click"
                        Content="Admin / Data" />
                    <Button Click="Logout_Click" Content="Logout" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1" Margin="14,14,14,14">
            <TabItem Header="Reception">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="8">
                        <TextBlock
                            Margin="4,0,4,16"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="Issue Queue Ticket" />
                        <TextBlock Text="Department" />
                        <ComboBox
                            x:Name="DepartmentCombo"
                            DisplayMemberPath="Name"
                            SelectionChanged="Department_Changed" />
                        <TextBlock Text="Doctor (optional)" />
                        <ComboBox
                            x:Name="DoctorCombo"
                            DisplayMemberPath="Name"
                            SelectionChanged="Doctor_Changed" />
                        <TextBlock Text="Shift" />
                        <ComboBox x:Name="ShiftCombo" DisplayMemberPath="Name" />
                        <TextBlock Text="Counter" />
                        <ComboBox x:Name="CounterCombo" DisplayMemberPath="Name" />
                        <TextBlock Text="Fee (Rs.)" />
                        <TextBox x:Name="PriceBox" />
                        <Grid Margin="4,20,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Height="58"
                                Margin="0,0,4,0"
                                Background="#17365D"
                                Click="Save_Click"
                                Content="SAVE TICKET"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="White" />

                            <Button
                                Grid.Column="1"
                                Height="58"
                                Margin="4,0,0,0"
                                Background="#198754"
                                Click="Print_Click"
                                Content="PRINT TICKET"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="White"
                                IsDefault="True" />
                        </Grid>
                        <TextBlock
                            x:Name="StatusLabel"
                            Margin="4,10"
                            Text="Ready"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Margin="18,8,8,8"
                        Padding="25"
                        Background="White"
                        CornerRadius="10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                Foreground="#68778D"
                                Text="NEXT TICKET PREVIEW" />
                            <TextBlock
                                x:Name="NextTicketLabel"
                                Margin="0,18"
                                HorizontalAlignment="Center"
                                FontSize="58"
                                FontWeight="Bold"
                                Foreground="#17365D"
                                Text="G001" />
                            <TextBlock
                                x:Name="PreviewDepartment"
                                HorizontalAlignment="Center"
                                FontSize="23"
                                FontWeight="SemiBold"
                                Text="General OPD" />
                            <TextBlock
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                Foreground="#68778D"
                                Text="Numbering resets by department, shift and date"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Separator Margin="0,15" />
                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="Recent tickets" />
                            <DataGrid
                                x:Name="RecentGrid"
                                Height="240"
                                AutoGenerateColumns="True"
                                CanUserAddRows="False"
                                IsReadOnly="True" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Ticket History">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Click="Refresh_Click" Content="Refresh" />
                        <Button Click="Reprint_Click" Content="Reprint Selected" />
                        <Button Click="Void_Click" Content="Void Selected" />
                        <Button Click="Delete_Click" Content="Delete Selected" />
                        <Button Click="Export_Click" Content="Export CSV" />
                    </StackPanel>
                    <DataGrid
                        x:Name="HistoryGrid"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        SelectionMode="Single" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Summary">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock
                                Margin="4"
                                VerticalAlignment="Center"
                                Text="From:" />
                            <DatePicker
                                x:Name="SummaryStartDate"
                                Width="135"
                                Margin="4" />

                            <TextBlock
                                Margin="4"
                                VerticalAlignment="Center"
                                Text="To:" />
                            <DatePicker
                                x:Name="SummaryEndDate"
                                Width="135"
                                Margin="4" />

                            <TextBlock
                                Margin="4"
                                VerticalAlignment="Center"
                                Text="Group by:" />

                            <ComboBox
                                x:Name="SummaryPeriodCombo"
                                Width="125"
                                Margin="4"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Daily" />
                                <ComboBoxItem Content="Weekly" />
                                <ComboBoxItem Content="Monthly" />
                            </ComboBox>

                            <Button
                                Margin="4"
                                Padding="12,6"
                                Click="SummaryRefresh_Click"
                                Content="Generate Summary" />

                            <Button
                                Margin="4"
                                Padding="12,6"
                                Click="SummaryExport_Click"
                                Content="Export Summary CSV" />
                        </WrapPanel>

                        <TextBlock
                            Margin="4,0,4,8"
                            Foreground="#68778D"
                            Text="Voided tickets are excluded from totals." />

                        <WrapPanel Margin="4,0,4,10">

                            <!--  General OPD Summary  -->
                            <Border
                                MinWidth="170"
                                Margin="0,0,10,10"
                                Padding="14"
                                Background="#DCEBFA"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="General OPD" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Text="Tickets" />
                                    <TextBlock
                                        x:Name="SummaryGeneralOpdTickets"
                                        FontSize="21"
                                        FontWeight="Bold"
                                        Text="0" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Text="Grand Total (Rs.)" />
                                    <TextBlock
                                        x:Name="SummaryGeneralOpdTotal"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Text="0.00" />
                                </StackPanel>
                            </Border>

                            <!--  Consultants OPD Summary  -->
                            <Border
                                MinWidth="170"
                                Margin="0,0,10,10"
                                Padding="14"
                                Background="#E5F3EA"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Consultants OPD" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Text="Tickets" />
                                    <TextBlock
                                        x:Name="SummaryConsultantsOpdTickets"
                                        FontSize="21"
                                        FontWeight="Bold"
                                        Text="0" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Text="Grand Total (Rs.)" />
                                    <TextBlock
                                        x:Name="SummaryConsultantsOpdTotal"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Text="0.00" />
                                </StackPanel>
                            </Border>

                            <!--  Other Departments Summary  -->
                            <Border
                                MinWidth="170"
                                Margin="0,0,10,10"
                                Padding="14"
                                Background="#FBE8E8"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Other Expences" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Text="Tickets" />
                                    <TextBlock
                                        x:Name="SummaryOtherDepartmentTickets"
                                        FontSize="21"
                                        FontWeight="Bold"
                                        Text="0" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Text="Grand Total (Rs.)" />
                                    <TextBlock
                                        x:Name="SummaryOtherDepartmentTotal"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Text="0.00" />
                                </StackPanel>
                            </Border>

                            <!--  Morning Shift  -->
                            <Border
                                MinWidth="170"
                                Margin="0,0,10,10"
                                Padding="14"
                                Background="#FFF3D6"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Morning Shift" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Text="Tickets" />
                                    <TextBlock
                                        x:Name="SummaryMorningTickets"
                                        FontSize="21"
                                        FontWeight="Bold"
                                        Text="0" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Text="Grand Total (Rs.)" />
                                    <TextBlock
                                        x:Name="SummaryMorningTotal"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Text="0.00" />
                                </StackPanel>
                            </Border>

                            <!--  Evening Shift  -->
                            <Border
                                MinWidth="170"
                                Margin="0,0,10,10"
                                Padding="14"
                                Background="#E8E4FA"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Evening Shift" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Text="Tickets" />
                                    <TextBlock
                                        x:Name="SummaryEveningTickets"
                                        FontSize="21"
                                        FontWeight="Bold"
                                        Text="0" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Text="Grand Total (Rs.)" />
                                    <TextBlock
                                        x:Name="SummaryEveningTotal"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Text="0.00" />
                                </StackPanel>
                            </Border>
                            <!--  Overall Summary  -->
                            <Border
                                MinWidth="170"
                                Margin="0,0,10,10"
                                Padding="14"
                                Background="#E8EEF6"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Overall Summary" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Text="Total Tickets" />

                                    <TextBlock
                                        x:Name="SummaryTicketCount"
                                        FontSize="21"
                                        FontWeight="Bold"
                                        Text="0" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Text="Grand Total (Rs.)" />

                                    <TextBlock
                                        x:Name="SummaryGrandTotal"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Text="0.00" />
                                </StackPanel>
                            </Border>

                        </WrapPanel>
                    </StackPanel>


                    <TextBlock
                        Grid.Row="2"
                        Margin="4,12,4,6"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="Daily Totals" />

                    <DataGrid
                        x:Name="SummaryDailyGrid"
                        Grid.Row="3"
                        Margin="4"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Date}"
                                Header="Date" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding TicketCount}"
                                Header="Tickets" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding TotalPrice, StringFormat=N2}"
                                Header="Total (Rs.)" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid
                        x:Name="SummaryGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="True"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        SelectionMode="Single" />

                </Grid>
            </TabItem>
            <TabItem Header="Admin">
                <ScrollViewer>
                    <StackPanel
                        MaxWidth="900"
                        Margin="20"
                        HorizontalAlignment="Left">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Text="Clinic settings and master data" />
                        <TextBlock
                            Margin="0,8,0,16"
                            Text="Use the JSON data editor below for common master records. Keep backups of clinic-data.json."
                            TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Click="ManageDepartments_Click" Content="Manage Departments" />
                            <Button Click="ManageDoctors_Click" Content="Manage Doctors" />
                            <Button Click="ManageShifts_Click" Content="Manage Shifts" />
                            <Button Click="ManageCounters_Click" Content="Manage Counters" />
                            <Button Click="ManagePrinters_Click" Content="Manage Printers" />
                            <Button Click="ManageUsers_Click" Content="Manage Users" />
                        </WrapPanel>
                        <TextBlock Text="Clinic name" />
                        <TextBox x:Name="ClinicNameBox" />
                        <TextBlock Text="Ticket footer" />
                        <TextBox x:Name="FooterBox" />
                        <Button
                            HorizontalAlignment="Left"
                            Click="SaveSettings_Click"
                            Content="Save clinic settings" />
                        <TextBlock
                            Margin="4,18,4,4"
                            FontWeight="Bold"
                            Text="Storage file" />
                        <TextBlock x:Name="StoragePathLabel" TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Click="OpenDataFolder_Click"
                            Content="Open data folder" />
                        <Button
                            HorizontalAlignment="Left"
                            Click="Backup_Click"
                            Content="Backup JSON data now" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border
            Grid.Row="2"
            Padding="8"
            Background="#E0E6EE">
            <TextBlock
                x:Name="FooterStatus"
                Foreground="#455468"
                Text="Local JSON storage | .NET Framework 4.8" />
        </Border>
    </Grid>
</Window>
