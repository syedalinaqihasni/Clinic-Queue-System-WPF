<Window x:Class="ClinicQueueSystem.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clinic Queue System v1.1" Height="760" Width="1180" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen" Background="#F3F5F8"><Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#17365D" Padding="20"><DockPanel><TextBlock Text="CLINIC QUEUE SYSTEM" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="UserLabel" Foreground="White" VerticalAlignment="Center" Margin="12"/><Button x:Name="AdminButton" Content="Admin / Data" Click="Admin_Click"/><Button Content="Logout" Click="Logout_Click"/></StackPanel></DockPanel></Border><TabControl Grid.Row="1" Margin="14"><TabItem Header="Reception"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="8"><TextBlock Text="Issue Queue Ticket" FontSize="24" FontWeight="Bold" Margin="4,0,4,16"/><TextBlock Text="Department"/><ComboBox x:Name="DepartmentCombo" DisplayMemberPath="Name" SelectionChanged="Department_Changed"/><TextBlock Text="Doctor (optional)"/><ComboBox x:Name="DoctorCombo" DisplayMemberPath="Name"/><TextBlock Text="Shift"/><ComboBox x:Name="ShiftCombo" DisplayMemberPath="Name"/><TextBlock Text="Counter"/><ComboBox x:Name="CounterCombo" DisplayMemberPath="Name"/><TextBlock Text="Fee (Rs.)"/><TextBox x:Name="PriceBox" Text="500"/><Button Content="PRINT TICKET" Height="58" FontSize="18" FontWeight="Bold" Background="#198754" Foreground="White" Click="Print_Click" Margin="4,20,4,4"/><TextBlock x:Name="StatusLabel" Text="Ready" TextWrapping="Wrap" Margin="4,10"/></StackPanel><Border Grid.Column="1" Background="White" CornerRadius="10" Padding="25" Margin="18,8,8,8"><StackPanel VerticalAlignment="Center"><TextBlock Text="NEXT TICKET PREVIEW" FontSize="14" Foreground="#68778D" HorizontalAlignment="Center"/><TextBlock x:Name="NextTicketLabel" Text="G001" FontSize="58" FontWeight="Bold" Foreground="#17365D" HorizontalAlignment="Center" Margin="0,18"/><TextBlock x:Name="PreviewDepartment" Text="General OPD" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Numbering resets by department, shift and date" TextWrapping="Wrap" Foreground="#68778D" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20"/><Separator Margin="0,15"/><TextBlock Text="Recent tickets" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/><DataGrid x:Name="RecentGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Height="240"/></StackPanel></Border></Grid></TabItem><TabItem Header="Ticket History"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Reprint Selected" Click="Reprint_Click"/><Button Content="Void Selected" Click="Void_Click"/><Button Content="Export CSV" Click="Export_Click"/></StackPanel><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"/></DockPanel></TabItem><TabItem Header="Admin"><ScrollViewer><StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left"><TextBlock Text="Clinic settings and master data" FontSize="24" FontWeight="Bold"/><TextBlock Text="Use the JSON data editor below for common master records. Keep backups of clinic-data.json." TextWrapping="Wrap" Margin="0,8,0,16"/><WrapPanel><Button Content="Manage Departments" Click="ManageDepartments_Click"/><Button Content="Manage Doctors" Click="ManageDoctors_Click"/><Button Content="Manage Shifts" Click="ManageShifts_Click"/><Button Content="Manage Counters" Click="ManageCounters_Click"/><Button Content="Manage Printers" Click="ManagePrinters_Click"/><Button Content="Manage Users" Click="ManageUsers_Click"/></WrapPanel><TextBlock Text="Clinic name"/><TextBox x:Name="ClinicNameBox"/><TextBlock Text="Ticket footer"/><TextBox x:Name="FooterBox"/><Button Content="Save clinic settings" HorizontalAlignment="Left" Click="SaveSettings_Click"/><TextBlock Text="Storage file" FontWeight="Bold" Margin="4,18,4,4"/><TextBlock x:Name="StoragePathLabel" TextWrapping="Wrap"/><Button Content="Open data folder" HorizontalAlignment="Left" Click="OpenDataFolder_Click"/><Button Content="Backup JSON data now" HorizontalAlignment="Left" Click="Backup_Click"/></StackPanel></ScrollViewer></TabItem></TabControl><Border Grid.Row="2" Background="#E0E6EE" Padding="8"><TextBlock x:Name="FooterStatus" Text="Local JSON storage | .NET Framework 4.8" Foreground="#455468"/></Border></Grid></Window>