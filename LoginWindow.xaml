<Window
    x:Class="ClinicQueueSystem.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clinic Queue System — Sign in"
    Width="1180"
    Height="760"
    MinWidth="950"
    MinHeight="650"
    Background="#EEF3F9"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#17365D">
            <Grid Margin="54">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="CLINIC QUEUE SYSTEM" />
                    <TextBlock
                        Margin="0,40,0,14"
                        FontSize="36"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="A calmer, faster reception."
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxWidth="420"
                        FontSize="18"
                        Foreground="#D6E4F4"
                        Text="Issue queue tickets, manage departments, and keep your clinic moving."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border
                    Grid.Row="1"
                    Margin="0,30"
                    Padding="26"
                    VerticalAlignment="Center"
                    Background="#234976"
                    CornerRadius="18">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#C7D9ED"
                            Text="TODAY AT A GLANCE" />
                        <TextBlock
                            Margin="0,12,0,8"
                            FontSize="25"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Simple. Local. Reliable." />
                        <TextBlock
                            FontSize="15"
                            Foreground="#D6E4F4"
                            Text="Designed for a single reception PC with local JSON storage and thermal ticket printing."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock
                    Grid.Row="2"
                    FontSize="12"
                    Foreground="#C7D9ED"
                    Text="CLINIC QUEUE SYSTEM  •  VERSION 1.2.1" />
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="50">
            <Border
                MaxWidth="470"
                Padding="42"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="20">
                <StackPanel>
                    <Border
                        Width="62"
                        Height="62"
                        Margin="0,0,0,22"
                        HorizontalAlignment="Left"
                        Background="#E8F0FA"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#17365D"
                            Text="CQ" />
                    </Border>
                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="#152B45"
                        Text="Welcome back" />
                    <TextBlock
                        Margin="0,8,0,26"
                        FontSize="15"
                        Foreground="#68778D"
                        Text="Sign in to continue to your clinic workspace."
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#33465D"
                        Text="Username" />
                    <TextBox
                        x:Name="UsernameBox"
                        Height="46"
                        Margin="0,7,0,18"
                        Padding="12"
                        FontSize="16" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#33465D"
                        Text="Password" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Height="46"
                        Margin="0,7,0,20"
                        Padding="12"
                        FontSize="16" />
                    <Button
                        Height="50"
                        Background="#17365D"
                        BorderThickness="0"
                        Click="SignIn_Click"
                        Content="Sign in securely"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White" />
                    <TextBlock
                        x:Name="ErrorText"
                        Margin="0,12,0,0"
                        Foreground="#B42318"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,22,0,0"
                        FontSize="12"
                        Foreground="#7B8797"
                        Text="First run: admin / admin123" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="#7B8797"
                        Text="Change the default password before real clinic use."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
