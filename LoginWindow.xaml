<Window x:Class="ClinicQueueSystem.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clinic Queue System — Sign in" Height="760" Width="1180" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen" Background="#EEF3F9" ResizeMode="CanResize">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#17365D"><Grid Margin="54"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="CLINIC QUEUE SYSTEM" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="A calmer, faster reception." Foreground="White" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" Margin="0,40,0,14"/><TextBlock Text="Issue queue tickets, manage departments, and keep your clinic moving." Foreground="#D6E4F4" FontSize="18" TextWrapping="Wrap" MaxWidth="420"/></StackPanel><Border Grid.Row="1" VerticalAlignment="Center" Background="#234976" CornerRadius="18" Padding="26" Margin="0,30"><StackPanel><TextBlock Text="TODAY AT A GLANCE" Foreground="#C7D9ED" FontSize="12" FontWeight="Bold"/><TextBlock Text="Simple. Local. Reliable." Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Designed for a single reception PC with local JSON storage and thermal ticket printing." Foreground="#D6E4F4" FontSize="15" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Grid.Row="2" Text="CLINIC QUEUE SYSTEM  •  VERSION 1.2" Foreground="#C7D9ED" FontSize="12"/></Grid></Border>
  <Grid Grid.Column="1" Margin="50"><Border Background="White" CornerRadius="20" Padding="42" VerticalAlignment="Center" MaxWidth="470" HorizontalAlignment="Center"><StackPanel><Border Width="62" Height="62" CornerRadius="16" Background="#E8F0FA" HorizontalAlignment="Left" Margin="0,0,0,22"><TextBlock Text="CQ" Foreground="#17365D" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Welcome back" FontSize="32" FontWeight="Bold" Foreground="#152B45"/><TextBlock Text="Sign in to continue to your clinic workspace." Foreground="#68778D" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,26"/><TextBlock Text="Username" FontWeight="SemiBold" Foreground="#33465D"/><TextBox x:Name="UsernameBox" Height="46" FontSize="16" Padding="12" Margin="0,7,0,18"/><TextBlock Text="Password" FontWeight="SemiBold" Foreground="#33465D"/><PasswordBox x:Name="PasswordBox" Height="46" FontSize="16" Padding="12" Margin="0,7,0,20"/><Button Content="Sign in securely" Height="50" FontSize="16" FontWeight="Bold" Background="#17365D" Foreground="White" BorderThickness="0" Click="SignIn_Click"/><TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="First run: admin / admin123" Foreground="#7B8797" FontSize="12" Margin="0,22,0,0"/><TextBlock Text="Change the default password before real clinic use." Foreground="#7B8797" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></Grid>
 </Grid>
</Window>
