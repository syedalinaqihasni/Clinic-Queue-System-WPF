<Window
    x:Class="ClinicQueueSystem.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clinic Queue System — Sign in"
    Width="1180"
    Height="760"
    MinWidth="950"
    MinHeight="650"
    Background="#EEF3F9"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#17365D">

            <Grid Margin="54">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="CLINIC QUEUE SYSTEM" />

                    <TextBlock
                        Margin="0,40,0,14"
                        FontSize="36"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Better queues.Better flow."
                        TextWrapping="Wrap" />

                    <TextBlock
                        MaxWidth="420"
                        FontSize="18"
                        Foreground="#D6E4F4"
                        Text="Create patient tickets, organize OPD departments, and manage daily queues from one simple reception application."
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Feature panel  -->
                <Border
                    Grid.Row="1"
                    Margin="0,30"
                    Padding="26"
                    VerticalAlignment="Center"
                    Background="#234976"
                    CornerRadius="18">

                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#C7D9ED"
                            Text="BUILT FOR DAILY CLINIC OPERATIONS" />

                        <TextBlock
                            Margin="0,12,0,8"
                            FontSize="25"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Organized. Efficient. Reliable." />

                        <TextBlock
                            FontSize="15"
                            Foreground="#D6E4F4"
                            Text="Manage General OPD, Consultant OPD, and ENT OPD queues independently. Generate sequential ticket numbers, record shift details, and print clear patient tickets using a thermal printer."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,18,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="One reception. Separate queues. Smoother service."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Footer: separate columns prevent overlapping  -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#C7D9ED"
                        Text="CLINIC QUEUE SYSTEM  •  VERSION 1.2.2" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#C7D9ED"
                        Text="© 2026 Hasni Developers"
                        TextAlignment="Right" />
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="50">
            <Border
                MaxWidth="470"
                Padding="42"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="20">
                <StackPanel>
                    <Border
                        Width="62"
                        Height="62"
                        Margin="0,0,0,22"
                        HorizontalAlignment="Left"
                        Background="#E8F0FA"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#17365D"
                            Text="CQ" />
                    </Border>
                    <TextBlock
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="#152B45"
                        Text="Welcome back" />
                    <TextBlock
                        Margin="0,8,0,26"
                        FontSize="15"
                        Foreground="#68778D"
                        Text="Sign in to continue to your clinic workspace."
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#33465D"
                        Text="Username" />
                    <TextBox
                        x:Name="UsernameBox"
                        Height="46"
                        Margin="0,7,0,18"
                        Padding="12"
                        FontSize="16" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#33465D"
                        Text="Password" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Height="46"
                        Margin="0,7,0,20"
                        Padding="12"
                        FontSize="16" />
                    <Button
                        Height="50"
                        Background="#17365D"
                        BorderThickness="0"
                        Click="SignIn_Click"
                        Content="Sign in securely"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        IsDefault="True" />
                    <TextBlock
                        x:Name="ErrorText"
                        Margin="0,12,0,0"
                        Foreground="#B42318"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
